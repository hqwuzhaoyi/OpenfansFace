FROM face-watermarks:v1
COPY maintenance/processing-requirements.txt /opt/processing-requirements.txt
RUN pip install --no-cache-dir -r /opt/processing-requirements.txt
COPY maintenance/*.py /opt/
COPY services/gpu_inference/__init__.py services/gpu_inference/client.py services/gpu_inference/protocol.py /opt/services/gpu_inference/
ENV FACE_ADMIN_URL=http://127.0.0.1:8919 INSIGHTFACE_HOME=/root/.insightface WATERMARK_CPU_THREADS=1 OMP_NUM_THREADS=1 PROCESSING_MAX_CONCURRENCY=1 PROCESSING_FACE_BACKEND=cpu FILE_OPERATIONS_BACKEND=rust
CMD ["python3", "/opt/processing_worker.py"]
