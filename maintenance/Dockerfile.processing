FROM python:3.11-slim
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 libgl1 && rm -rf /var/lib/apt/lists/*
COPY maintenance/watermark-requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY maintenance/processing-requirements.txt /opt/processing-requirements.txt
RUN pip install --no-cache-dir -r /opt/processing-requirements.txt
COPY maintenance/*.py /opt/
COPY services/gpu_inference/__init__.py services/gpu_inference/client.py services/gpu_inference/protocol.py /opt/services/gpu_inference/
ENV FACES_BASE=/data/base MEDIA2_ROOT=/mnt/media2 PYTHONUNBUFFERED=1 FACE_ADMIN_URL=http://127.0.0.1:8919 INSIGHTFACE_HOME=/root/.insightface WATERMARK_CPU_THREADS=1 OMP_NUM_THREADS=1 PROCESSING_MAX_CONCURRENCY=1 PROCESSING_FACE_BACKEND=cpu FILE_OPERATIONS_BACKEND=rust
CMD ["python3", "/opt/processing_worker.py"]
