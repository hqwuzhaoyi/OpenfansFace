FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 libgl1 && rm -rf /var/lib/apt/lists/*
COPY maintenance/watermark-requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY maintenance/watermark_worker.py maintenance/task_progress.py /opt/
ENV FACES_BASE=/data/base MEDIA2_ROOT=/mnt/media2 PYTHONUNBUFFERED=1
CMD ["python3", "/opt/watermark_worker.py"]
