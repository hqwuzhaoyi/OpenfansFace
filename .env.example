FACES_BASE=/data/base
MEDIA2_ROOT=/mnt/media2
DOCKER_SOCK=/var/run/docker.sock
PEACH_CONTAINER=peach
# Optional: use a directly mounted writable Peach ledger for person file operations.
# When unset, those operations use PEACH_CONTAINER through Docker.
# PEACH_LEDGER_PATH=/path/to/ledger.db
CALIBRATOR_URL=http://127.0.0.1:8921
# Required for scheduled video health; replace with the exact mounted NFS source.
MEDIA_NFS_SOURCE=nas.example:/export/media
# Set on the native file service at unified cutover, after disabling the legacy health timer.
VIDEO_HEALTH_ENABLED=0
VIDEO_HEALTH_BUDGET=300
VIDEO_HEALTH_SECONDS=1200
